<launch>

  <!--
    Isaac Sim variant of system_simulation_with_route_planner.launch: drops
    vehicle_simulator (kinematic body + Unity pose relay), ros_tcp_endpoint,
    and sim_image_repub. lidargen's go2_explore.py replaces all three by
    publishing /state_estimation, the map to sensor TF, and /registered_scan
    directly from Isaac Sim. Launch go2_explore.py separately (see
    system_isaacsim_with_route_planner.sh) before or after this file; the ROS2
    graph just needs both processes up before far_planner is given a goal.
  -->

  <arg name="sensorOffsetX" default="0.0"/>
  <arg name="sensorOffsetY" default="0.0"/>
  <arg name="cameraOffsetZ" default="0.0"/>
  <arg name="vehicleX" default="0.0"/>
  <arg name="vehicleY" default="0.0"/>
  <arg name="checkTerrainConn" default="true"/>

  <node pkg="joy" exec="joy_node" name="ps3_joy" output="screen" >
    <param name="dev" value="/dev/input/js0" />
    <param name="deadzone" value="0.12" />
    <param name="autorepeat_rate" value="0.0" />
  </node>

  <include file="$(find-pkg-share local_planner)/launch/local_planner.launch" >
    <arg name="sensorOffsetX" value="$(var sensorOffsetX)" />
    <arg name="sensorOffsetY" value="$(var sensorOffsetY)" />
    <arg name="cameraOffsetZ" value="$(var cameraOffsetZ)"/>
    <arg name="goalX" value="$(var vehicleX)"/>
    <arg name="goalY" value="$(var vehicleY)"/>
    <!-- No RViz control panel / joystick in this setup to switch modes, so
         start directly in autonomy (waypoint-following) mode. -->
    <arg name="autonomyMode" value="true"/>
    <!-- Legged-robot tuning (sim: favor speed). Loose heading gate keeps it
         driving while turning instead of rotating in place. -->
    <arg name="maxYawRate" value="90.0"/>
    <arg name="yawRateGain" value="2.0"/>
    <arg name="dirDiffThre" value="0.6"/>
  </include>

  <include file="$(find-pkg-share terrain_analysis)/launch/terrain_analysis.launch" >
    <!-- The current sim lidar preset has a ~1.1 m minimum range, leaving a
         no-return blind ring around the robot; with noDataObstacle=true that
         ring becomes a phantom obstacle wall ahead of the robot and forward
         paths are permanently blocked. Disable until the real sensor config
         (small min range) replaces the preset. -->
    <arg name="noDataObstacle" value="false"/>
  </include>

  <include file="$(find-pkg-share terrain_analysis_ext)/launch/terrain_analysis_ext.launch" >
    <arg name="checkTerrainConn" value="$(var checkTerrainConn)"/>
  </include>

  <include file="$(find-pkg-share sensor_scan_generation)/launch/sensor_scan_generation.launch" />

  <include file="$(find-pkg-share visualization_tools)/launch/visualization_tools.launch" />

  <include file="$(find-pkg-share far_planner)/launch/far_planner.launch" />

</launch>
